{
  "name": "ratecad",
  "version": "0.1.0",
  "private": true,
  "description": "RateCAD — desktop CAD drafting with AI command interface",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "pnpm --filter @ratecad/desktop dev",
    "build": "pnpm -r --filter './packages/*' build && pnpm --filter @ratecad/desktop build",
    "dist:win": "pnpm build && pnpm --filter @ratecad/desktop exec electron-builder --win nsis --x64 --publish never",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --filter './packages/*' test",
    "lint": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
